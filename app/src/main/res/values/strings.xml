    <!-- Setup -->
    <string name="setup_title">Set up log access</string>
    <string name="setup_explainer">Since Android 4.1, apps cannot read other apps\' logs without a grant. Shizuku and the ADB command need no root. Root also works, if this device already has it.</string>
    <string name="setup_shizuku_title">Shizuku (recommended)</string>
    <string name="setup_shizuku_desc">No root, no PC on Android 11+ via Wireless Debugging. Enables per-app filtering and the most reliable stream.</string>
    <string name="setup_shizuku_not_installed">Shizuku is not installed</string>
    <string name="setup_shizuku_not_running">Shizuku is installed but not running</string>
    <string name="setup_shizuku_needs_permission">Shizuku is running — permission needed</string>
    <string name="setup_shizuku_ready">Shizuku is ready</string>
    <string name="setup_get_shizuku">Get Shizuku</string>
    <string name="setup_open_shizuku">Open Shizuku</string>
    <string name="setup_grant_shizuku">Grant permission</string>
    <string name="setup_root_title">Root</string>
    <string name="setup_root_desc">With Magisk, KernelSU, or APatch, root reads the full log the same way Shizuku does. Nothing runs until you ask.</string>
    <string name="setup_root_grant">Use root</string>
    <string name="setup_root_ready">Root is ready</string>
    <string name="setup_root_denied">Root was denied</string>
    <string name="setup_root_unknown">Not requested</string>
    <string name="setup_root_checking">Waiting for the root manager…</string>
    <string name="setup_adb_title">ADB one-time grant</string>
    <string name="setup_adb_desc">With a computer, run this command once. The grant stays until you uninstall. On Android 13 and later, Android only shows the log access prompt while LogSleuth is on screen, and a background start is refused for about a minute. Shizuku or root keeps reading in the background.</string>
